<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dictionary</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Roboto:ital,wght@1,400&display=swap"
    rel="stylesheet"
  />
  <style>
    body {
      font-family: 'Poppins', sans-serif;
    }
    .italic-roboto {
      font-family: 'Roboto', serif;
      font-style: italic;
    }
  </style>
</head>
<body class="bg-white min-h-screen flex flex-col items-center px-6 pt-24">
  <h1 class="text-5xl font-semibold mb-20">Dictionary</h1>

  <form class="w-full max-w-xl">
    <label for="search" class="sr-only">Search for a word</label>
    <div class="relative">
      <input
        id="search"
        type="search"
        placeholder="Search for a word"
        class="w-full border border-gray-400 rounded-xl py-3 px-5 pr-14 text-gray-400 text-lg focus:outline-none focus:ring-2 focus:ring-orange-400"
      />
      <svg
        class="w-6 h-6 text-gray-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    </div>
  </form>

  <div class="flex items-center mt-14 space-x-6 w-full max-w-xl">
    <button
      aria-label="Play pronunciation"
      class="border border-gray-400 rounded-full p-4 flex items-center justify-center text-orange-400 hover:text-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-400"
      type="button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          d="M3 9v6h4l5 5V4L7 9H3z"
        />
      </svg>
    </button>
    <h2 class="text-5xl font-semibold text-orange-400">designer</h2>
  </div>

  <div class="w-full max-w-xl mt-10">
    <p class="italic font-serif text-base mb-1">Meaning :</p>
    <p class="text-base font-normal max-w-3xl ml-6">
      A person who plans the form, look, or workings of something before its being made or built, typically by drawing it in detail.
    </p>
    <p class="italic-roboto text-sm text-gray-400 max-w-3xl ml-6 mt-1">
      "She was one of the world's leading graphic designers."
    </p>
  </div>

  <div class="w-full max-w-xl mt-6">
    <p class="text-base font-normal max-w-3xl">Example :</p>
  </div>
</body>
</html>
